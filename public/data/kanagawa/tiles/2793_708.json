oy_museum.JPG","artist":"妖精書士","license":"CC BY-SA 3.0"},"t":[74]},{"id":"n1420817137","name":"山手資料館","lat":35.4384,"lon":139.65265,"cat":"museum","indoor":true,"f":["playground","toilets","indoor"],"kid":0.9,"nov":1,"rich":0.5,"apl":1,"city":"横浜市中区","web":"https://www.city.yokohama.lg.jp/kurashi/machizukuri-kankyo/toshiseibi/design/ikasu/rekishi/yamate-siryo.html","t":[74]},{"id":"n610953772","name":"フランス山","lat":35.44118,"lon":139.65351,"cat":"view","indoor":false,"f":["toilets","free"],"kid":0.5,"nov":1,"rich":0.4,"apl":0.7,"city":"横浜市中区","t":[73]},{"id":"n1420817157","name":"岩崎博物館（ゲーテ座記念）","lat":35.43951,"lon":139.65347,"cat":"museum","indoor":true,"f":["playground","toilets","indoor"],"kid":0.9,"nov":1,"rich":0.7,"apl":1,"city":"横浜市中区","web":"https://www.iwasaki.ac.jp/museum/","wd":"Q133287917","desc":"横浜開港期の服飾資料を中心とした博物館","t":[74]},{"id":"n4549051125","name":"レンガ造り井戸遺構","lat":35.44092,"lon":139.65397,"cat":"history","indoor":false,"f":["toilets","free"],"kid":0.5,"nov":1,"rich":0.4,"apl":1,"city":"横浜市中区","t":[50]},{"id":"n9847876840","name":"アメリカ山","lat":35.44123,"lon":139.65159,"cat":"view","indoor":false,"f":["toilets","free"],"kid":0.5,"nov":0.78,"rich":0.85,"apl":0.7,"city":"横浜市中区","wd":"Q11285132","desc":"横浜市中区にある立体都市公園","wp":{"title":"アメリカ山公園","extract":"アメリカ山公園（アメリカやまこうえん）は、神奈川県横浜市中区山手町に位置し、みなとみらい線「元町・中華街駅」の駅舎上部に整備された全国初の立体都市公園である。公園面積は約0.6ヘクタール。 横浜開港150周年となる2009年（平成21年）8月7日に一部開園。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/89/Amerikayama_park_in_Yokohama-city_naka-ward.JPG/960px-Amerikayama_park_in_Yokohama-city_naka-ward.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Amerikayama_park_in_Yokohama-city_naka-ward.JPG","artist":"ootahara","license":"CC BY-SA 3.0"},"t":[73]},{"id":"n11062734991","name":"世界の広場","lat":35.44408,"lon":139.65272,"cat":"other","indoor":false,"f":["toilets"],"kid":0.4,"nov":1,"rich":0.4,"apl":0.6,"city":"横浜市中区","t":[71]},