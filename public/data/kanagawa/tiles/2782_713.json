[{"id":"n2417236751","name":"生藤山","lat":35.67242,"lon":139.13239,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":0.73,"rich":0.85,"apl":0.7,"city":"相模原市緑区","wd":"Q10872033","wp":{"title":"生藤山","extract":"生藤山（しょうとうさん）は、笹尾根にある標高990.3mの山。山体は東京都西多摩郡檜原村と神奈川県相模原市緑区にまたがり、山頂部は東京都側に位置する。奥多摩山域の南端。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/%E7%94%9F%E8%97%A4%E5%B1%B1_2013-04-20_-_panoramio.jpg/960px-%E7%94%9F%E8%97%A4%E5%B1%B1_2013-04-20_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:%E7%94%9F%E8%97%A4%E5%B1%B1_2013-04-20_-_panoramio.jpg","artist":"takeshi yagi","license":"CC BY-SA 3.0"},"t":[91]},{"id":"n2417236754","name":"茅丸","lat":35.67235,"lon":139.13651,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":0.78,"rich":0.6,"apl":0.7,"city":"相模原市緑区","wd":"Q131683056","desc":"東京都と神奈川県の境にある山","wp":{"title":"茅丸","extract":"茅丸（かやまる）は、東京都西多摩郡檜原村と神奈川県相模原市緑区との境にある標高1019mの山である。別名は茅丸山（旧藤野町最高峰1019m）。"},"t":[91]},{"id":"n8981886587","name":"連行峰","lat":35.66999,"lon":139.14268,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":0.86,"rich":0.85,"apl":0.7,"city":"相模原市緑区","wd":"Q11639939","wp":{"title":"連行峰","extract":"連行峰（れんぎょうほう）は、東京都西多摩郡檜原村と神奈川県相模原市緑区との境にある標高1,016mの山である。奥多摩山域の南部、生藤山の東に位置する山で、神奈川県立陣馬相模湖自然公園に指定されている。登山道上の道標などでは、連行山（れんぎょうさん）とも表記される。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/Mt.Rengyouhou.JPG/960px-Mt.Rengyouhou.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Mt.Rengyouhou.JPG","artist":"Σ64","license":"CC BY-SA 3.0"},"t":[91]}]