/thumb/e/ea/Kamakura_zaimokuza_20180619.jpg/960px-Kamakura_zaimokuza_20180619.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Kamakura_zaimokuza_20180619.jpg","artist":"Kaba-maru","license":"CC BY-SA 4.0"}},{"id":"w53752092","name":"七里ヶ浜","lat":35.30582,"lon":139.50273,"cat":"water","indoor":false,"f":["toilets","free"],"kid":0.9,"nov":0.49,"rich":0.85,"apl":1,"city":"鎌倉市","wd":"Q7496115","desc":"神奈川県鎌倉市の海岸","wp":{"title":"七里ヶ浜","extract":"七里ヶ浜（しちりがはま）は、神奈川県鎌倉市南西部にある相模湾に面した2.9kmほどの浜で、稲村ヶ崎と小動岬の間にある。日本の渚100選の一つで鎌倉市の町名でもある。現行の行政地名は七里ガ浜一丁目及び二丁目並びに七里ガ浜東一丁目から七里ガ浜東五丁目。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6f/230128_At_Shichirigahama_Kamakura_Kanagawa_pref_Japan02s3.jpg/960px-230128_At_Shichirigahama_Kamakura_Kanagawa_pref_Japan02s3.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:230128_At_Shichirigahama_Kamakura_Kanagawa_pref_Japan02s3.jpg","artist":"663highland","license":"CC BY-SA 4.0"}},{"id":"w53750907","name":"七里ヶ浜","lat":35.30398,"lon":139.51718,"cat":"water","indoor":false,"f":["free"],"kid":0.85,"nov":0.49,"rich":0.85,"apl":1,"city":"鎌倉市","wd":"Q7496115","desc":"神奈川県鎌倉市の海岸","wp":{"title":"七里ヶ浜","extract":"七里ヶ浜（しちりがはま）は、神奈川県鎌倉市南西部にある相模湾に面した2.9kmほどの浜で、稲村ヶ崎と小動岬の間にある。日本の渚100選の一つで鎌倉市の町名でもある。現行の行政地名は七里ガ浜一丁目及び二丁目並びに七里ガ浜東一丁目から七里ガ浜東五丁目。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6f/230128_At_Shichirigahama_Kamakura_Kanagawa_pref_Japan02s3.jpg/960px-230128_At_Shichirigahama_Kamakura_Kanagawa_pref_Japan02s3.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:230128_At_Shichirigahama_Kamakura_Kanagawa_pref_Japan02s3.jpg","artist":"663highland","license":"CC BY-SA 4.0"}},{"id":"w390608380","name":"腰越ラッコ公園","lat":35.30676,"lon":139.5019,"cat":"park","indoor":false,"f":["toilets",