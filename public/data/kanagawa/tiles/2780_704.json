[{"id":"n1420831376","name":"箱根園水族館","lat":35.21224,"lon":139.00931,"cat":"zoo","indoor":true,"f":["toilets","indoor"],"kid":1,"nov":0.73,"rich":0.95,"apl":1,"city":"箱根","web":"https://www.princehotels.co.jp/amuse/hakone-en/","wd":"Q11603362","desc":"神奈川県箱根町にあるリゾート施設","wp":{"title":"箱根園","extract":"箱根園（はこねえん）は、神奈川県足柄下郡箱根町元箱根の芦ノ湖湖畔東側と神奈川県道75号線沿いにある、コテージ・植物園・水族館・ショッピングモールなどの複合リゾート施設である。関係施設と併せて、芦ノ湖周辺の観光エリアの一つを形成している。 箱根における西武グループ（旧コクド・西武鉄道・伊豆箱根鉄道）の開発拠点であり、経営は2006年3月の西武ホールディングス再編まではコクド・西武鉄道、それ以降は西武・プリンスホテルズワールドワイドが担当している。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Hakone-en_Zoo_-_Hakone%2C_Japan_-_DSC05664.jpg/960px-Hakone-en_Zoo_-_Hakone%2C_Japan_-_DSC05664.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Hakone-en_Zoo_-_Hakone,_Japan_-_DSC05664.jpg","artist":"Daderot","license":"CC0"}},{"id":"n5658824922","name":"芦ノ湖遊覧船","lat":35.21147,"lon":139.00864,"cat":"other","indoor":false,"f":[],"kid":0.35,"nov":1,"rich":0.4,"apl":0.6,"city":"箱根"},{"id":"n10132659717","name":"平和の鳥居","lat":35.20274,"lon":139.02574,"cat":"other","indoor":false,"f":["toilets"],"kid":0.4,"nov":1,"rich":0.4,"apl":0.6,"city":"箱根"},{"id":"n7796157196","name":"玉村豊男ライフアートミュージアム","lat":35.20354,"lon":139.03082,"cat":"museum","indoor":true,"f":["playground","toilets","free","indoor"],"kid":0.95,"nov":1,"rich":0.4,"apl":1,"city":"箱根"},{"id":"n6167529855","name":"二代目ゴンドラ","lat":35.24422,"lon":139.00601,"cat":"other","indoor":false,"f":[],"kid":0.35,"nov":1,"rich":0.4,"apl":0.6,"city":"箱根"},{"id":"n6167529856","name":"初代ゴンドラ","lat":35.24427,"lon":139.00597,"cat":"other","indoor":false,"f":[],"kid":0.35,"nov":1,"rich":0.4,"apl":0.6,"city":"箱根"},{"id":"n4358112298","name":"駒ヶ岳","lat":35.22497,"lon":139.02482,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":0.68,"rich":0.85,"apl":0.7,"city":"箱根","wd":"Q31454757","desc":"箱根にある山のひとつ","wp":{"title":"箱根駒ヶ岳","extract":"箱根駒ヶ岳（はこねこまがたけ）は、神奈川県足柄下郡箱根町にある標高1,356メートルの山。箱根山（箱根火山）の中央火口丘を構成している一峰である。単に駒ヶ岳とも表記される。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Hakone-jinja_torii_-_Hakone%2C_Japan_-_DSC05478.jpg/960px-Hakone-jinja_torii_-_Hakone%2C_Japan_-_DSC05478.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Hakone-jinja_torii_-_Hakone,_Japan_-_DSC05478.jpg","artist":"Daderot","license":"CC0"}},{"id":"n2406928527","name":"冠ヶ岳","lat":35.23528,"lon":139.02051,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":0.68,"rich":0.85,"apl":0.7,"city":"箱根","wd":"Q11395033","desc":"神奈川県箱根町にある火山","wp":{"title":"冠ヶ岳","extract":"冠ヶ岳（かんむりがたけ）は、神奈川県足柄下郡箱根町にある標高1,409mの火山。箱根山（箱根火山）の中央火口丘を構成している一峰である。約2,900年前に、神山の北西斜面で水蒸気爆発が発生し、大きな崩壊が起こった。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3f/Mt.Kanmurigatake_from_Owakudani_02.jpg/960px-Mt.Kanmurigatake_from_Owakudani_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Mt.Kanmurigatake_from_Owakudani_02.jpg","artist":"Σ64","license":"CC BY 3.0"}},{"id":"n2407810960","name":"神山","lat":35.23348,"lon":139.02097,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":0.62,"rich":0.85,"apl":0.7,"city":"箱根","wd":"Q10871928","desc":"箱根火山の一峰","wp":{"title":"神山","extract":"神山（かみやま）は神奈川県足柄下郡箱根町にある標高1,438mの山。箱根山（箱根火山）の中央火口丘の一つでその最高峰である。古くから神の山として崇められてきたことからこの名がついた。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b7/Lake_Ashi_and_Hakone_volcano_20101204.jpg/960px-Lake_Ashi_and_Hakone_volcano_20101204.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Lake_Ashi_and_Hakone_volcano_20101204.jpg","artist":"Batholith","license":"Public domain"}},{"id":"n5059644222","name":"箱根ジオミュージアム","lat":35.24357,"lon":139.01952,"cat":"museum","indoor":true,"f":["toilets","indoor"],"kid":0.75,"nov"