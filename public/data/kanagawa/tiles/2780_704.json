.0463,"cat":"museum","indoor":true,"f":["indoor"],"kid":0.7,"nov":0.65,"rich":0.95,"apl":1,"city":"箱根","web":"https://www.okada-museum.com/","wd":"Q17224006","desc":"神奈川県箱根町にある美術館","wp":{"title":"岡田美術館","extract":"岡田美術館（おかだびじゅつかん）は、神奈川県足柄下郡箱根町にある私設美術館。ユニバーサルエンターテインメント系列。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/251122_Okada_Museum_of_Art_Hakone_Japan03s3.jpg/960px-251122_Okada_Museum_of_Art_Hakone_Japan03s3.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:251122_Okada_Museum_of_Art_Hakone_Japan03s3.jpg","artist":"663highland","license":"CC BY-SA 4.0"}},{"id":"n9938928795","name":"箱根強羅公園熱帯植物園","lat":35.24913,"lon":139.04541,"cat":"park","indoor":false,"f":["free"],"kid":0.5,"nov":0.78,"rich":0.95,"apl":0.6,"city":"箱根","web":"https://www.hakone-tozan.co.jp/gorapark/map/tropical/","wd":"Q11487751","wp":{"title":"強羅公園","extract":"強羅公園（ごうらこうえん）は、神奈川県足柄下郡箱根町強羅にある、小田急箱根が運営する公園。箱根強羅公園とも呼ばれる。国の登録記念物。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/81/211126_Gora_Park_Hakone_Japan01s3.jpg/960px-211126_Gora_Park_Hakone_Japan01s3.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:211126_Gora_Park_Hakone_Japan01s3.jpg","artist":"663highland","license":"CC BY-SA 4.0"}},{"id":"n13476447895","name":"箱根写真美術館","lat":35.24994,"lon":139.04605,"cat":"museum","indoor":true,"f":["indoor"],"kid":0.7,"nov":1,"rich":0.4,"apl":1,"city":"箱根"},{"id":"w1221222709","name":"だっこしてZOO","lat":35.21208,"lon":139.01018,"cat":"zoo","indoor":false,"f":["toilets"],"kid":1,"nov":1,"rich":0.4,"apl":1,"city":"箱根"},{"id":"w24573023","name":"箱根駒ヶ岳ロープウェー","lat":35.21843,"lon":139.01709,"cat":"other","indoor":false,"f":[],"kid":0.35,"nov":0.57,"rich":0.95,"apl":0.6,"city":"箱根","hours":"Mo-Su 09:00-16:50","web":"https://www.princehotels.co.jp/amuse/hakone-en/ropeway/operation.html","wd":"Q864350","desc":"神奈川県箱根町にある索道","wp":{"title":"箱根 駒ヶ岳ロープウェー","extract":"箱根 駒ヶ岳ロープウェー（はこね こまがたけロープウェー）は、神奈川県足柄下郡箱根町の箱根駒ヶ岳を登る、西武・プリンスホテルズワールドワイドが運営する全長1,783 mの索道である。2016年1月までは、伊豆箱根鉄道の駒ヶ岳索道線（こまがたけさくどうせん）として運営されていた。 同索道は箱根火山の中央火口丘である標高1,327 mの駒ヶ岳の頂上部と、芦ノ湖畔の箱根園と結び、山頂部は箱根周辺の市街地や富士山などを見渡せるなど展望に優れ多くの観光客が訪れる。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Hakone_komagatake_ropeway01.JPG/960px-Hakone_komagatake_ropeway01.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Hakone_komagatake_ropeway01.JPG","artist":"Σ64","license":"CC BY-SA 3.0"}},{"id":"w543027961","name":"箱根神社宝物殿","lat":35.20409,"lon":139.02481,"cat":"museum","indoor":true,"f":["toilets","indoor"],"kid":0.75,"nov":0.51,"rich":0.95,"apl":1,"city":"箱根","hours":"Mo-Su 09:00-16:00","web":"https://hakonejinja.or.jp/","wd":"Q705310","desc":"神奈川県足柄下郡箱根町元箱根にある神社","wp":{"title":"箱根神社","extract":"箱根神社（はこねじんじゃ）は、神奈川県足柄下郡箱根町元箱根にある神社。旧社格は国幣小社。かつては箱根権現、三所大権現とも称された。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Hakonejinja_-02.jpg/960px-Hakonejinja_-02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Hakonejinja_-02.jpg","artist":"Aimaimyi","license":"CC BY-SA 3.0"}},{"id":"w327550627","name":"箱根・芦ノ湖成川美術館","lat":35.20006,"lon":139.03119,"cat":"museum","indoor":true,"f":["toilets","indoor"],"kid":0.75,"nov":0.73,"rich":0.95,"apl":1,"city":"箱根","hours":"Mo-Su 09:00-17:00","web":"http://www.narukawamuseum.co.jp/","wd":"Q10855979","desc":"日本の美術館","wp":{"title":"成川美術館","extract":"成川美術館（なるかわびじゅつかん）は、神奈川県足柄下郡箱根町元箱根にある美術館。1988年に開館した。個人美術館であり、日本画家の作品4000点余りを所有している。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/23/230909_Narukawa_Art_Museum_Hakone_Japan05s3.jpg/960px-230909_Narukawa_Art_Museum_Hakone_Japan05s3.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:230909_Narukawa_Art_Museum_Hakone_Japan05s3.jpg","artist":"663highland","license":"CC BY-SA 4.0"}},{"id":"w835214558","name":"箱根公園","lat":35.20232,"lon":139.03084,"cat":"park","indoor":false,"f":["toilets","free"],"kid":0.7,"nov":1,"rich":0.4,"apl":0.2,"city":"箱根"},{"id":"w835257713","name":"石仏群と歴史館","lat":35.21299,"lon":139.0357,"cat":"museum","indoor":true,"f":["indoor"],"kid":0.7,"nov":1,"rich":0.4,"apl":1,"city":"箱根"},{"id":"w727045804","name":"大涌谷","lat":35.24676,"lon":139.02502,"cat":"other","indoor":false,"f":[],"kid":0.35,"nov":0.47,"rich":0.85,"apl":0.6,"city":"箱根","wd":"Q1134429","desc":"神奈川県箱根町にある火山地形","wp":{"title":"大涌谷","extract":"大涌谷（おおわくだに）は、神奈川県箱根町にある箱根火山の火山性地すべりによる崩壊地形。箱根火山の中央火口丘である冠ヶ岳の標高800 mから1,000 mの北側斜面にあり、地熱地帯で活発な噴気地帯でもある。箱根火山に多数有る噴気地帯の中では最大規模のものである。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/af/%E5%A4%A7%E6%B6%8C%E8%B0%B7_-_panoramio.jpg/960px-%E5%A4%A7%E6%B6%8C%E8%B0%B7_-_panoramio.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:%E5%A4%A7%E6%B6%8C%E8%B0%B7_-_panoramio.jpg","artist":"ohkubo","license":"CC BY-SA 3.0"}},{"id":"w281489340","name":"強羅公園","lat":35.24863,"lon":139.04499,"cat":"park","indoor":false,"f":["large"],"kid":0.6,"nov":0.78,"rich":0.95,"apl":1,"ha":2.9,"city":"箱根","hours":"09:00-17:00","web":"https://www.hakone-tozan.co.jp/gorapark/","wd":"Q11487751","wp":{"title":"強羅公園","extract":"強羅公園（ごうらこうえん）は、神奈川県足柄下郡箱根町強羅にある、小田急箱根が運営する公園。箱根強羅公園とも呼ばれる。国の登録記念物。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/81/211126_Gora_Park_Hakone_Japan01s3.jpg/960px-211126_Gora_Park_Hakone_Japan01s3.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:211126_Gora_Park_Hakone_Japan01s3.jpg","artist":"663highland","license":"CC BY-SA 4.0"}},{"id":"w354207853","name":"三河屋蓬來園","lat":35.23749,"lon":139.04808,"cat":"park","indoor":false,"f":["free"],"kid":0.65,"nov":1,"rich":0.4,"apl":0.6,"city":"箱根"},{"id":"w1054387277","name":"箱根美術館","lat":35.24819,"lon":139.04281,"cat":"museum","indoor":true,"f":["indoor"],"kid":0.7,"nov":0.62,"rich":0.95,"apl":1,"city":"箱根","hours":"09:30-16:00","web":"https://moaart.or.jp/hakone/","wd":"Q11284659","desc":"神奈川県箱根町にある美術館","wp":{"title":"箱根美術館","extract":"箱根美術館（はこねびじゅつかん）は、神奈川県足柄下郡箱根町の神仙郷にある、箱根で最も古い美術館である。東洋・日本美術のうち、陶磁器を公開している。1952年（昭和27年）6月15日に開館した。"},"img":{"url":"https://upload.wikimedia.org/wikipedia/commons/c/c3/%E7%AE%B1%E6%A0%B9%E7%BE%8E%E8%A1%93%E9%A4%A8%E6%9C%AC%E9%A4%A8.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:%E7%AE%B1%E6%A0%B9%E7%BE%8E%E8%A1%93%E9%A4%A8%E6%9C%AC%E9%A4%A8.jpg","artist":"Hakone museum","license":"CC BY-SA 3.0"}}]