[{"id":"n2348909914","name":"ダルマ沢ノ頭","lat":35.40816,"lon":139.1108,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":1,"rich":0.4,"apl":0.7,"city":"松田町"},{"id":"n14077121260","name":"伊勢沢ノ頭","lat":35.42588,"lon":139.10572,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":0.86,"rich":0.6,"apl":0.7,"city":"松田町","wd":"Q140912578","desc":"神奈川県足柄上郡松田町と山北町にまたがる山","wp":{"title":"伊勢沢ノ頭","extract":"伊勢沢ノ頭（いせざわのあたま、いせざわのかしら）は、神奈川県足柄上郡松田町と山北町の境にある丹沢山地の山である。標高は1,177メートルで、檜岳山稜の最高点にあたる。"}},{"id":"n7334603156","name":"檜岳","lat":35.4313,"lon":139.11562,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":0.68,"rich":0.85,"apl":0.7,"city":"山北町","wd":"Q10871880","wp":{"title":"檜岳","extract":"檜岳（ひのきだっか）は、丹沢山地南部の檜岳山稜に位置する標高1,167メートルの山である。神奈川県足柄上郡山北町と松田町の境にあり、丹沢大山国定公園に属する。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Mt.Hinokidakka_from_Mt.Shidango.JPG/960px-Mt.Hinokidakka_from_Mt.Shidango.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Mt.Hinokidakka_from_Mt.Shidango.JPG","artist":"Σ64","license":"CC BY-SA 3.0"}},{"id":"n7334603153","name":"シダンゴ山","lat":35.40832,"lon":139.12348,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":0.68,"rich":0.85,"apl":0.7,"city":"松田町","wd":"Q6421031","wp":{"title":"シダンゴ山","extract":"シダンゴ山（震旦郷山、しだんごやま）は、丹沢山地の南部に位置する標高758mの山である。神奈川県松田町内にあり、丹沢大山国定公園に属する。 展望の良い山で、相模湾や富士山や丹沢山地の山々など360度の景色を楽しめる。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/ba/Mt.Shidango-top.JPG/960px-Mt.Shidango-top.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Mt.Shidango-top.JPG","artist":"Σ64","license":"CC BY-SA 3.0"}},{"id":"n14281882180","name":"蜂花苑 ミロクキャンプ場","lat":35.4153,"lon":139.13148,"cat":"nature","indoor":false,"f":["toilets"],"kid":0.65,"nov":1,"rich":0.4,"apl":1,"city":"松田町"},{"id":"n7334603157","name":"雨山","lat":35.43795,"lon":139.12332,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":0.78,"rich":0.85,"apl":0.7,"city":"山北町","wd":"Q31516240","desc":"神奈川県松田町と山北町の境にある丹沢山地の山","wp":{"title":"雨山 (神奈川県)","extract":"雨山（あめやま）は、神奈川県足柄上郡松田町と山北町の境にある標高1,176メートルの山である。丹沢山地南部の檜岳山稜に位置し、西側の檜岳、伊勢沢ノ頭を経て秦野峠へ、東側は雨山峠を経て鍋割山方面へ稜線が続く。 雨山一帯は丹沢大山国定公園に属する。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Mount_Ameyama_as_seen_from_Mount_Nabewari.jpg/960px-Mount_Ameyama_as_seen_from_Mount_Nabewari.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Mount_Ameyama_as_seen_from_Mount_Nabewari.jpg","artist":"Azegamaru","license":"CC BY 4.0"}},{"id":"n1970901525","name":"鍋割山","lat":35.44385,"lon":139.14153,"cat":"view","indoor":false,"f":["toilets","free"],"kid":0.5,"nov":0.68,"rich":0.85,"apl":0.7,"city":"秦野市","wd":"Q10871822","wp":{"title":"鍋割山 (神奈川県)","extract":"鍋割山（なべわりやま）は、丹沢大山国定公園に含まれ、丹沢山地の南部に聳える標高1,272メートルの山である。 神奈川県の中西部に位置する秦野市、丹沢山系への登山口の町であり丹沢山系から足柄平野に掛かる足柄地域に位置する松田町、足柄上郡に属し町域の大半を丹沢山地が占める山北町の市町村境に位置する。別名、三ノ萱（さんのかや）とも呼ばれ、測量標の一つである三等三角点のある三角点峰である。"},"img":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ea/Mt.Nabewari_01.jpg/960px-Mt.Nabewari_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Mt.Nabewari_01.jpg","artist":"Σ64","license":"CC BY 3.0"}},{"id":"n2136775612","name":"櫟山","lat":35.4187,"lon":139.14817,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":1,"rich":0.4,"apl":0.7,"city":"秦野市"},{"id":"n2136775523","name":"栗ノ木洞","lat":35.42419,"lon":139.1467,"cat":"view","indoor":false,"f":["free"],"kid":0.45,"nov":0.86,"rich":0.6,"apl":0.7,"city":"松田町","wd":"Q11535793","wp":{"title":"栗ノ木洞","extract":"栗ノ木洞（くりのきどう）は丹沢大山国定公園内、神奈川県秦野市と足柄上郡松田町の境にある標高908.3mの山である。「表丹沢県民の森」の散策路が通じている。また、稜線伝いに後沢乗越を経て鍋割山へ至る道がある。"}},{"id":"w411639526","name":"寄みやま運動広場","lat":35.40071,"lon":139.13762,"cat":"park","indoor":false,"f":["toilets","free"],"kid":0.7,"nov":1,"rich":0.5,"apl":0.6,"city":"松田町","web":"https://town.matsuda.kanagawa.jp/site/kankou-sub/miyamaundou.html"}]