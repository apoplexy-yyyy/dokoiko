{
  "name": "dokoiko",
  "private": true,
  "version": "0.21.0",
  "type": "module",
  "description": "どこいこ - 子供とのお出かけ先を偶然発見する静的Webアプリ",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "collect": "tsx scripts/collect-all.ts",
    "collect:osm": "tsx scripts/collect-osm.ts",
    "collect:news": "tsx scripts/collect-news.ts",
    "collect:events": "tsx scripts/collect-events.ts",
    "collect:extra": "tsx scripts/collect-overture.ts && tsx scripts/collect-pref.ts && tsx scripts/collect-gbif.ts && tsx scripts/collect-wikidata.ts",
    "check:web": "tsx scripts/check-websites.ts",
    "build:data": "tsx scripts/build-data.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@duckdb/node-api": "^2.0.1-r.1",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
